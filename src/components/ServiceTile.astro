---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  href: string;
  img: ImageMetadata;
}
const { title, href, img } = Astro.props;
---

<a
  href={href}
  class="block rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg transition group"
>
  <div class="h-68 md:h-64">
    <Image
      src={img}
      alt={title}
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
      widths={[300, 500, 700]}
      sizes="(max-width: 640px) 100vw, 33vw"
    />
  </div>
  <div
    class="bg-royall-dark text-white px-4 py-3 flex items-center justify-between"
  >
    <span class="font-medium text-sm">{title}</span>
    <span
      class="text-royall-gold group-hover:translate-x-1 transition-transform"
      >→</span
    >
  </div>
</a>

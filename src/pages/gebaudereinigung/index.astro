---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";

import heroImg from "../../assets/bilder/gebaudereinigung/man-doing-professional-home-cleaning-service.jpg";
import unterhaltImg from "../../assets/bilder/gebaudereinigung/person-taking-care-office-cleaning.jpg";
import glasImg from "../../assets/bilder/gebaudereinigung/pexels-mikkel-jul-774849604-18885426.jpg";
import grundImg from "../../assets/bilder/gebaudereinigung/full-shot-people-cleaning-office.jpg";
import bauendImg from "../../assets/bilder/gebaudereinigung/full-shot-man-vacuuming-office-floor.jpg";

const items = [
  {
    title: "Unterhaltsreinigung",
    desc: "Regelmäßige Reinigung von Büro- und Geschäftsräumen.",
    img: unterhaltImg,
  },
  {
    title: "Glasreinigung",
    desc: "Streifenfreie Fenster, Fassaden und Glasflächen.",
    img: glasImg,
  },
  {
    title: "Grundreinigung",
    desc: "Intensive Tiefenreinigung stark beanspruchter Flächen.",
    img: grundImg,
  },
  {
    title: "Bauendreinigung",
    desc: "Bezugsfertige Reinigung nach Bau- und Renovierungsarbeiten.",
    img: bauendImg,
  },
];
---

<Layout title="Gebäudereinigung | Royall Service & Security">
  <Header />

  <section class="relative bg-royall-dark text-white">
    <div
      class="max-w-5xl mx-auto px-4 md:px-6 py-16 md:py-20 grid md:grid-cols-2 gap-10 items-center"
    >
      <div>
        <p class="text-royall-gold font-semibold mb-2">
          Für die regelmäßige Reinigung Ihres Unternehmens
        </p>
        <h1 class="text-3xl md:text-4xl font-bold mb-6">Gebäudereinigung</h1>
        <p class="text-gray-300 leading-relaxed">
          Sauberkeit schafft Vertrauen. Besonders in Arbeitsumgebungen, die
          täglich genutzt werden. Mit unserer professionellen
          Unterhaltsreinigung sorgen wir dafür, dass Ihre Räume stets gepflegt,
          hygienisch und einladend bleiben. Ob Bürogebäude, Arztpraxis, Schule
          oder Industriehalle: Wir passen die Reinigung individuell an Ihre
          Bedürfnisse und Nutzungsfrequenzen an. Zuverlässig, gründlich und
          termingerecht.
        </p>
      </div>
      <div class="h-64 md:h-80 rounded-xl overflow-hidden">
        <Image
          src={heroImg}
          alt="Team bei der Gebäudereinigung"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          widths={[500, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
        />
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14 md:py-16">
    <p class="text-gray-700 leading-relaxed mb-10">
      Unser erfahrenes Team arbeitet nach strukturierten Reinigungsplänen und
      mit modernen, umweltschonenden Verfahren. Dabei achten wir nicht nur auf
      sichtbare Sauberkeit, sondern auch auf die Werterhaltung Ihrer Einrichtung
      und Böden.
    </p>

    <h2 class="text-xl md:text-2xl font-bold mb-6">
      Unsere Leistungen in der Gebäudereinigung:
    </h2>
    <div class="grid sm:grid-cols-2 gap-6 mb-10">
      {
        items.map((i) => (
          <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
            <div class="h-76">
              <Image
                src={i.img}
                alt={i.title}
                class="w-full h-full object-cover object-center"
                loading="lazy"
                decoding="async"
                widths={[300, 500, 700]}
                sizes="(max-width: 640px) 100vw, 50vw"
              />
            </div>
            <div class="p-5">
              <h3 class="font-semibold mb-1">{i.title}</h3>
              <p class="text-sm text-gray-600">{i.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <a
      href="/kontakt"
      class="inline-block bg-royall-gold text-royall-dark font-semibold px-6 py-3 rounded-md hover:opacity-90 transition"
    >
      Angebot anfordern
    </a>
  </section>

  <Footer />
</Layout>

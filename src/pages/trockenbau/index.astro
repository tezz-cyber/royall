---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ServiceTile from "../../components/ServiceTile.astro";
import Footer from "../../components/Footer.astro";

import trennwandImg from "../../assets/bilder/trockenbau/trennwand.jpg";
import deckenImg from "../../assets/bilder/trockenbau/deckaufhaengen.avif";
import dachgeschossImg from "../../assets/bilder/trockenbau/dachgeschossausbau.jpg";
import daemmungImg from "../../assets/bilder/trockenbau/daemmung-schallschutz.avif";
import spachtelImg from "../../assets/bilder/trockenbau/spachtelarbeiten.jpg";

const items = [
  {
    title: "Trennwände",
    href: "/trockenbau/trennwaende",
    img: trennwandImg,
  },
  {
    title: "Abgehängte Decken",
    href: "/trockenbau/abgehaengte-decken",
    img: deckenImg,
  },
  {
    title: "Dachgeschossausbau",
    href: "/trockenbau/dachgeschossausbau",
    img: dachgeschossImg,
  },
  /* { title: "Vorsatzschalen", href: "/trockenbau/vorsatzschalen" }, */
  {
    title: "Dämmung & Schallschutz",
    href: "/trockenbau/daemmung-schallschutz",
    img: daemmungImg,
  },
  {
    title: "Spachtelarbeiten",
    href: "/trockenbau/spachtelarbeiten",
    img: spachtelImg,
  },
];
---

<Layout title="Trockenbau | Royall Service & Security">
  <Header />
  <section class="max-w-6xl mx-auto px-4 md:px-6 py-16 md:py-20">
    <span
      class="inline-block bg-royall-gold text-royall-dark text-xs font-semibold px-3 py-1 rounded-full mb-4"
      >Von Royall für Sie</span
    >
    <h1 class="text-3xl font-bold mb-10">Trockenbau</h1>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {
        items.map((s) => (
          <ServiceTile title={s.title} href={s.href} img={s.img} />
        ))
      }
    </div>
  </section>
  <Footer />
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";

import heroImg from "../../assets/bilder/gebaudeservice/pexels-bulat843-1243575272-38524262.jpg";
import hausmeisterImg from "../../assets/bilder/gebaudeservice/istockphoto-1282328221-612x612.jpg";
import gruenflaechenImg from "../../assets/bilder/gebaudeservice/pexels-marianna-zuzanna-498248397-16442678.jpg";
import teppichImg from "../../assets/bilder/gebaudeservice/pexels-michelangelo-buonarroti-4176235.jpg";

const items = [
  {
    title: "Hausmeisterservice",
    desc: "Technische und organisatorische Betreuung Ihrer Immobilie.",
    img: hausmeisterImg,
  },
  /* {
    title: "Schädlingsbekämpfung",
    desc: "Fachgerechte Bekämpfung und Prävention von Schädlingsbefall.",
  }, */
  {
    title: "Grünflächenpflege",
    desc: "Pflege von Rasenflächen, Hecken und Außenanlagen.",
    img: gruenflaechenImg,
  },
  {
    title: "Teppichreinigung",
    desc: "Schonende Tiefenreinigung textiler Bodenbeläge.",
    img: teppichImg,
  },
];
---

<Layout title="Gebäudeservice | Royall Service & Security">
  <Header />

  <section class="relative bg-royall-dark text-white">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-16 md:py-20">
      <p class="text-royall-gold font-semibold mb-2">
        Rundum-Betreuung für Ihre Immobilie
      </p>
      <h1 class="text-3xl md:text-4xl font-bold mb-6">Gebäudeservice</h1>
      <p class="text-gray-300 max-w-2xl leading-relaxed">
        Eine Immobilie benötigt mehr als nur Reinigung. Mit unserem
        Gebäudeservice übernehmen wir die technische Betreuung,
        Grünflächenpflege, Schädlingsbekämpfung und Teppichreinigung, damit Sie
        sich um Ihr Kerngeschäft kümmern können, während wir uns um Ihr Objekt
        kümmern.
      </p>
    </div>
    <div class="h-68 md:h-64">
      <Image
        src={heroImg}
        alt="Gebäudeservice"
        class="w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1536]}
        sizes="100vw"
      />
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14 md:py-16">
    <p class="text-gray-700 leading-relaxed mb-10">
      Von der regelmäßigen technischen Kontrolle bis zur saisonalen Außenpflege:
      Wir sind Ihr fester Ansprechpartner vor Ort und reagieren schnell und
      zuverlässig auf Ihre Anliegen.
    </p>

    <h2 class="text-xl md:text-2xl font-bold mb-6">
      Unsere Leistungen im Gebäudeservice:
    </h2>
    <div class="grid sm:grid-cols-2 gap-6 mb-10">
      {
        items.map((i) => (
          <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
            <div class="h-36">
              <Image
                src={i.img}
                alt={i.title}
                class="w-full h-full object-cover object-center"
                loading="lazy"
                decoding="async"
                widths={[300, 500, 700]}
                sizes="(max-width: 640px) 100vw, 50vw"
              />
            </div>
            <div class="p-5">
              <h3 class="font-semibold mb-1">{i.title}</h3>
              <p class="text-sm text-gray-600">{i.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <a
      href="/kontakt"
      class="inline-block bg-royall-gold text-royall-dark font-semibold px-6 py-3 rounded-md hover:opacity-90 transition"
    >
      Angebot anfordern
    </a>
  </section>

  <Footer />
</Layout>

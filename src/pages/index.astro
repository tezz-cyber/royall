---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Footer from "../components/Footer.astro";

import gebaudereinigungImg from "../assets/bilder/gebaudereinigung/full-shot-man-vacuuming-office-floor.jpg";
import gebaudeserviceImg from "../assets/bilder/gebaudeservice/treppen-reinigung-draussen.jpg";
/* import trockenbauImg from "../assets/bilder/trockenbau/brian-wangenheim-2ZMe-E2NBZ0-unsplash.jpg";
import securityImg from "../assets/bilder/security/revier-streifendienst.png"; */

const categories = [
  {
    title: "Gebäudereinigung",
    desc: "Unterhalts-, Glas-, Grund- & Bauendreinigung.",
    href: "/gebaudereinigung",
    img: gebaudereinigungImg,
  },
  {
    title: "Gebäudeservice",
    desc: "Hausmeister, Schädlinge, Grünflächen, Teppiche.",
    href: "/gebaudeservice",
    img: gebaudeserviceImg,
  },
  /* {
    title: "Trockenbau",
    desc: "Trennwände, Decken, Dachgeschoss, Dämmung & Spachtel.",
    href: "/trockenbau",
    img: trockenbauImg,
  },
  {
    title: "Security",
    desc: "Objekt-, Baustellen-, Empfangs- & Veranstaltungsschutz.",
    href: "/security",
    img: securityImg,
  }, */
];
---

<Layout title="Royall Service & Security Dienstleistung GmbH">
  <Header />
  <Hero />
  <section class="max-w-4xl mx-auto px-4 md:px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center">
      Unsere Leistungsbereiche
    </h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {categories.map((s) => <ServiceCard {...s} />)}
    </div>
  </section>
  <Footer />
</Layout>
